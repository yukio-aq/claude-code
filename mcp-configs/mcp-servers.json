{
  "_readme": "このファイルは ~/.claude.json への追加用テンプレートです。`claude mcp add` コマンドの代わりに直接 ~/.claude.json の mcpServers にコピペして使えます。Figma,Tavily は FIGMA_API_KEY を実際のトークンに置き換えてから追加してください。",
  "mcpServers": {
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp@latest", "--figma-api-key", "${FIGMA_API_KEY}", "--stdio"]
    }
  }
}